# Copy this file to `.env` and paste your keys after the `=`.
# `.env` is git-ignored, so your keys never get committed.
# You only need the key for the provider you actually use.
# Ollama (local) needs no key at all.

# https://console.groq.com  -> API Keys
GROQ_API_KEY=

# https://aistudio.google.com  -> Get API key
GEMINI_API_KEY=

# https://openrouter.ai  -> Keys
OPENROUTER_API_KEY=

# Only if you route calls through the Switchboard gateway and it requires a key.
SWITCHBOARD_API_KEY=
